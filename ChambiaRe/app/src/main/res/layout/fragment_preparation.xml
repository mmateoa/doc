<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/preparation_help" android:textSize="14sp" android:textColor="@color/text_secondary" />
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginVertical="16dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/details" style="@style/Widget.Chambia.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/draft_details" />
    <com.google.android.material.button.MaterialButton android:id="@+id/new_draft" style="@style/Widget.Chambia.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/new_draft" />
    <com.google.android.material.button.MaterialButton android:id="@+id/add" style="@style/Widget.Chambia.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/add_to_offer" />
    <FrameLayout android:id="@+id/meal_editor" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/offer_empty" android:textColor="@color/text_secondary" android:textSize="16sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/items" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/review" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/review_menu" />
</LinearLayout>