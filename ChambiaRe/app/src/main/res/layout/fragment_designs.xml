<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_title" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/design_help" android:textColor="@color/text_secondary" android:textSize="16sp" android:layout_marginVertical="12dp" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/filters" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.chip.Chip android:id="@+id/all" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/all_templates" android:checked="true" />
        <com.google.android.material.chip.Chip android:id="@+id/free" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/free_templates" />
        <com.google.android.material.chip.Chip android:id="@+id/favorites" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/favorite_templates" />
    </com.google.android.material.chip.ChipGroup>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/empty_favorites" android:textColor="@color/text_secondary" android:textSize="16sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/templates" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
</LinearLayout>